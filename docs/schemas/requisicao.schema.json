{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LDTLuis/modulo-calculo-api/blob/main/docs/schemas/requisicao.schema.json",
  "title": "Requisição ao motor de cálculo (contrato 1.0)",
  "type": "object",
  "required": [
    "versao_contrato",
    "operacao"
  ],
  "additionalProperties": false,
  "properties": {
    "versao_contrato": {
      "type": "string",
      "pattern": "^1\\.\\d+$",
      "examples": [
        "1.0"
      ]
    },
    "operacao": {
      "enum": [
        "info",
        "validar_configuracao",
        "processar_lote",
        "listar_calculos",
        "calcular"
      ]
    },
    "barragem": {
      "type": "object",
      "description": "Identificação da barragem (livre)."
    },
    "configuracao": {
      "$ref": "configuracao.schema.json"
    },
    "opcoes": {
      "type": "object",
      "properties": {
        "agora": {
          "type": "string",
          "description": "ISO 8601 com fuso."
        },
        "graficos": {
          "type": "object",
          "properties": {
            "diretorio": {
              "type": "string",
              "minLength": 1
            },
            "formato": {
              "enum": [
                "png",
                "svg"
              ],
              "default": "png"
            }
          },
          "additionalProperties": false,
          "required": [
            "diretorio"
          ]
        }
      },
      "additionalProperties": false
    },
    "medicoes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/medicao"
      }
    },
    "historico": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/medicao"
      }
    },
    "calculo": {
      "enum": [
        "classificacao.enquadramento_pnsb",
        "classificacao.risco",
        "emergencia.nivel_resposta",
        "emergencia.zas",
        "estabilidade.gravidade_deslizamento",
        "estabilidade.gravidade_resultante",
        "estabilidade.talude_bishop",
        "estabilidade.talude_fellenius",
        "geometria.borda_livre",
        "geometria.secao_macico",
        "geometria.volume_terra",
        "hidrologia.curva_cota_volume",
        "hidrologia.extravasor",
        "hidrologia.indice_demanda",
        "hidrologia.metodo_racional",
        "hidrologia.periodo_retorno",
        "hidrologia.vazao_medida",
        "hidrologia.volume_secoes",
        "hidrostatica.carga_rede_fluxo",
        "hidrostatica.empuxo",
        "hidrostatica.piezometro",
        "hidrostatica.pressao",
        "hidrostatica.subpressao",
        "opcionais.balanco_hidrico",
        "opcionais.evapotranspiracao_fao56",
        "opcionais.pico_ruptura_froehlich",
        "opcionais.vertedor_retangular",
        "opcionais.vertedor_triangular",
        "percolacao.darcy",
        "percolacao.filtro_terzaghi",
        "percolacao.piping",
        "percolacao.vazao_rede_fluxo"
      ]
    },
    "entradas": {
      "type": "object"
    },
    "modulo": {
      "enum": [
        "classificacao",
        "emergencia",
        "estabilidade",
        "geometria",
        "hidrologia",
        "hidrostatica",
        "opcionais",
        "percolacao"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operacao": {
            "const": "validar_configuracao"
          }
        }
      },
      "then": {
        "required": [
          "configuracao"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operacao": {
            "const": "processar_lote"
          }
        }
      },
      "then": {
        "required": [
          "medicoes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operacao": {
            "const": "calcular"
          }
        }
      },
      "then": {
        "required": [
          "calculo"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "calculo": {
            "const": "classificacao.enquadramento_pnsb"
          }
        },
        "required": [
          "calculo"
        ]
      },
      "then": {
        "properties": {
          "entradas": {
            "$ref": "calculos.schema.json#/$defs/classificacao.enquadramento_pnsb"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "calculo": {
            "const": "classificacao.risco"
          }
        },
        "required": [
          "calculo"
        ]
      },
      "then": {
        "properties": {
          "entradas": {
            "$ref": "calculos.schema.json#/$defs/classificacao.risco"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "calculo": {
            "const": "emergencia.nivel_resposta"
          }
        },
        "required": [
          "calculo"
        ]
      },
      "then": {
        "properties": {
          "entradas": {
            "$ref": "calculos.schema.json#/$defs/emergencia.nivel_resposta"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "calculo": {
            "const": "emergencia.zas"
          }
        },
        "required": [
          "calculo"
        ]
      },
      "then": {
        "properties": {
          "entradas": {
            "$ref": "calculos.schema.json#/$defs/emergencia.zas"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "calculo": {
            "const": "estabilidade.gravidade_deslizamento"
          }
        },
        "required": [
          "calculo"
        ]
      },
      "then": {
        "properties": {
          "entradas": {
            "$ref": "calculos.schema.json#/$defs/estabilidade.gravidade_deslizamento"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "calculo": {
            "const": "estabilidade.gravidade_resultante"
          }
        },
        "required": [
          "calculo"
        ]
      },
      "then": {
        "properties": {
          "entradas": {
            "$ref": "calculos.schema.json#/$defs/estabilidade.gravidade_resultante"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "calculo": {
            "const": "estabilidade.talude_bishop"
          }
        },
        "required": [
          "calculo"
        ]
      },
      "then": {
        "properties": {
          "entradas": {
            "$ref": "calculos.schema.json#/$defs/estabilidade.talude_bishop"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "calculo": {
            "const": "estabilidade.talude_fellenius"
          }
        },
        "required": [
          "calculo"
        ]
      },
      "then": {
        "properties": {
          "entradas": {
            "$ref": "calculos.schema.json#/$defs/estabilidade.talude_fellenius"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "calculo": {
            "const": "geometria.borda_livre"
          }
        },
        "required": [
          "calculo"
        ]
      },
      "then": {
        "properties": {
          "entradas": {
            "$ref": "calculos.schema.json#/$defs/geometria.borda_livre"
