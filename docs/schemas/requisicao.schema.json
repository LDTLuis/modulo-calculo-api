        },
        "required": [
          "calculo"
        ]
      },
      "then": {
        "properties": {
          "entradas": {
            "$ref": "calculos.schema.json#/$defs/hidrologia.curva_cota_volume"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "calculo": {
            "const": "hidrologia.extravasor"
          }
        },
        "required": [
          "calculo"
        ]
      },
      "then": {
        "properties": {
          "entradas": {
            "$ref": "calculos.schema.json#/$defs/hidrologia.extravasor"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "calculo": {
            "const": "hidrologia.indice_demanda"
          }
        },
        "required": [
