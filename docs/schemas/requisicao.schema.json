  "$defs": {
    "medicao": {
      "type": "object",
      "properties": {
        "sensor": {
          "type": [
            "string",
            "integer"
          ]
        },
        "tipo": {
          "type": "string",
          "description": "Um de ['nivel', 'pressao', 'vazao', 'deslocamento'] (aceita acento e maiúsculas)."
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601; sem offset, vale configuracao.fuso_padrao."
        },
        "valor": {
          "type": [
            "number",
            "string"
          ],
          "description": "Número; texto aceita vírgula decimal (\"12,5\")."
        },
        "unidade": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Registros inválidos não reprovam a requisição: voltam em `rejeicoes`.",
      "required": [
        "sensor",
        "tipo",
        "timestamp",
        "valor",
        "unidade"
      ]
    }
  }
